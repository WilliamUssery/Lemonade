# Copy to .env and fill in. Never commit or zip the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
SITE_URL=http://127.0.0.1:8000

# Leave unset to use local SQLite. Set to the Supabase Session pooler URI
# (Dashboard → Connect → Session pooler) to use Postgres.
# DATABASE_URL=postgresql://postgres.pfretrivmrrrhwyiskve:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Square Sandbox (developer.squareup.com → your app → Sandbox credentials).
# Leave blank to use the built-in test checkout.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://127.0.0.1:8000/payments/square/webhook/
